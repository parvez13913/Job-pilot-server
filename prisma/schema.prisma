generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(cuid())
  name     String?
  email    String  @unique
  password String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions     Session[]
  resumes      Resume[]
  jobs         Job[]
  applications Application[]
  coverLetters CoverLetter[]
  interviews   InterviewSession[]
}

model Session {
  id     String @id @default(cuid())
  userId String

  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Resume {
  id         String   @id @default(cuid())
  userId     String
  name       String
  fileUrl    String?
  rawText    String?
  parsedData Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id])
  versions ResumeVersion[]
}

model ResumeVersion {
  id        String   @id @default(cuid())
  resumeId  String
  jobId     String?
  content   Json
  createdAt DateTime @default(now())

  resume Resume @relation(fields: [resumeId], references: [id])
  job    Job?   @relation(fields: [jobId], references: [id])
}

model Job {
  id          String   @id @default(cuid())
  userId      String
  title       String
  company     String?
  description String
  parsedData  Json?
  createdAt   DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id])
  analyses       JobAnalysis[]
  applications   Application[]
  resumeVersions ResumeVersion[]
}

model JobAnalysis {
  id              String   @id @default(cuid())
  jobId           String
  resumeId        String
  matchScore      Int
  matchedSkills   Json
  missingSkills   Json
  keywords        Json
  recommendations Json
  createdAt       DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id])
}

model Application {
  id        String            @id @default(cuid())
  userId    String
  jobId     String
  status    ApplicationStatus
  appliedAt DateTime?
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id])
  job  Job  @relation(fields: [jobId], references: [id])
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

model CoverLetter {
  id        String   @id @default(cuid())
  userId    String
  jobId     String?
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model InterviewSession {
  id        String   @id @default(cuid())
  userId    String
  jobId     String?
  questions Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}
